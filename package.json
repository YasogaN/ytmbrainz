{
  "name": "ytmbrainz",
  "version": "0.1.0",
  "description": "MusicBrainz-compatible metadata server backed by YouTube Music (InnerTube)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:live": "RUN_LIVE=1 bun test tests/live",
    "preflight": "bun run check && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "youtubei.js": "^18.0.0"
  }
}
